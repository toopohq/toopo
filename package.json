{
  "name": "toopo",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --typecheck",
    "mutation": "node mutation/measure.ts",
    "tally": "node mutation/tally.ts",
    "meta": "vitest run --config mutation/vitest.config.ts",
    "registry": "tsc -p registry/tsconfig.json && vitest run --config registry/vitest.config.ts",
    "validation": "tsc -p validation/tsconfig.json && vitest run --config validation/vitest.config.ts",
    "cli": "tsc -p cli/tsconfig.json && vitest run --config cli/vitest.config.ts",
    "site": "tsc -p site/tsconfig.json && vitest run --config site/vitest.config.ts",
    "toopo": "node cli/toopo.ts",
    "site:build": "node site/build.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "fast-check": "^4.9.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  }
}
