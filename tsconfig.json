{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": [
    "packages/catalogue",
    "contracts",
    "mutation",
    "run-vitest.ts",
    "vitest-entry-point.ts",
    "vitest.config.ts"
  ]
}
